# Plantilla de variables de entorno del backend.
# Copiar a `servidor/.env` y completar los valores. NO subir el .env real.

PORT=3000

# Entorno. Con `production` el backend exige que los secretos y URLs de
# abajo estén definidos (si falta alguno, aborta el arranque a propósito).
NODE_ENV=development

# Base de datos MySQL
# Local (XAMPP): host localhost, puerto 3306, ssl false
# Railway:       host/puerto públicos del servicio MySQL, ssl true
MYSQLDB_HOST=localhost
MYSQLDB_PORT=3306
MYSQLDB_USER=bunyk_app
MYSQLDB_CONTRASENA=
MYSQLDB_DB=bunyk_db
MYSQLDB_SSL=false

# true fuerza re-crear la base al arrancar (PIERDE DATOS). En producción: false.
RESET_DB=false

# Secretos JWT (usa valores largos y aleatorios en producción)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EMAIL_SECRET=

# URLs públicas (en Render: la URL del servicio, p. ej. https://b-unick.onrender.com)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Correo — Gmail API (OAuth2 por HTTPS)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
MAIL_FROM=
MAIL_FROM_NAME=B-unick

# Cloudinary (backend: foto de perfil)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sightengine (moderación de contenido)
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
SIGHTENGINE_MODELOS=nudity-2.1,weapon,offensive,self-harm,gore-2.0,alcohol,violence
