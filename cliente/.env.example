# Plantilla de variables de entorno del frontend (Vite).
# Copiar a `cliente/.env`. Las variables VITE_ se embeben en el build,
# así que en Render deben estar definidas TAMBIÉN en tiempo de build.

# Cloudinary — Upload Widget unsigned (subida de videos/imágenes en /crear)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
